# Configuración de entorno — Micro-HIS RBAC
# Copie este archivo a .env y ajuste los valores.
# NUNCA suba .env al repositorio.

# Motor de base de datos (sqlite para desarrollo/pruebas, mysql para producción)
DB_CONNECTION=sqlite
DB_PATH=database/rbac_his.sqlite

# Solo para MySQL/PostgreSQL (ignorado con SQLite)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=micro_his_rbac
DB_USERNAME=root
DB_PASSWORD=
